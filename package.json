{
  "name": "apkstart",
  "productName": "ApkStart",
  "version": "0.4.5",
  "description": "Trình chạy ứng dụng Android trên Windows siêu nhẹ: nhấp đúp vào APK là cài, ứng dụng chạy trong cửa sổ riêng với biểu tượng trên desktop",
  "main": "src/main.js",
  "author": "RoutineMiku",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/MaricoJimmy/apk_running#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaricoJimmy/apk_running.git"
  },
  "bugs": {
    "url": "https://github.com/MaricoJimmy/apk_running/issues"
  },
  "keywords": [
    "android",
    "emulator",
    "apk",
    "windows",
    "qemu",
    "electron",
    "wsa",
    "freeform"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run-tests.js && node test/engine-test.js && node test/auto-test.js",
    "pack": "node build/pack.js",
    "runtime": "node build/prepare-runtime.js",
    "build:exe": "node build/prepare-runtime.js && electron-builder --win nsis",
    "selftest": "node scripts/selftest.js",
    "assoc:on": "node scripts/assoc.js on",
    "assoc:off": "node scripts/assoc.js off",
    "test:boot": "node test/boot-test.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@napi-rs/lzma": "^1.5.3"
  }
}
